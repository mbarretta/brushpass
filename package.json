{
  "name": "brushpass",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "env -u __NEXT_PRIVATE_STANDALONE_CONFIG next dev",
    "build": "env -u __NEXT_PRIVATE_STANDALONE_CONFIG next build --webpack",
    "start": "env -u __NEXT_PRIVATE_STANDALONE_CONFIG next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@noble/hashes": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "google-auth-library": "^11.0.1",
    "jose": "^6.2.8",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "fast-xml-parser": "^5.7.0",
    "fast-xml-builder": "^1.1.7",
    "@tootallnate/once": "^3.0.1",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "sharp": true
  }
}
