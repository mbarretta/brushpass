# Copy this file to terraform.tfvars and fill in all values.
#
# IMPORTANT: terraform.tfvars contains sensitive values (oidc_client_secret).
# Add it to .gitignore — do NOT commit it.

# ── Required ──────────────────────────────────────────────────────────────────

project_id = "pubsec-se"
region     = "us-central1"

# Build and push the image before applying. The docker_push_command output
# shows the exact command to use after the first apply.
container_image = "us-central1-docker.pkg.dev/pubsec-se/cloud-run-source-deploy/fileshare:latest"

# Set to false if the file-storage bucket already exists (e.g. pubsec-fileshare
# in the pubsec-se project). Set to true to have Terraform create it.
create_file_bucket = false
file_bucket_name   = "pubsec-fileshare"

# The SQLite FUSE volume bucket — always created by Terraform.
db_bucket_name = "pubsec-fileshare-db"

# NOTE: the Terraform-managed admin bootstrap (bootstrap_admin_user/_pass and
# the fileshare-bootstrap job) was retired 2026-08-14. For the first admin in a
# new environment, use the SSO admin-domain path (oidc_admin_domain below) or
# the one-off manual job documented in README.md → "Deploy to GCP with
# Terraform" → Step 4.

# ── OIDC issuer + admin domain (non-secret) ───────────────────────────────────
# These two are consumed by BOTH interactive OIDC login AND the agent
# device-grant flow (which reuses the issuer for endpoint discovery and the
# admin domain for permission resolution).
#
#   - oidc_issuer is REQUIRED for the agent flow; without it device-grant fails
#     with "AUTH_OIDC_ISSUER is not configured".
#   - oidc_admin_domain controls which accounts get upload+admin on the minted
#     key (and on first interactive OIDC sign-in). Leave unset to require manual
#     permission grants.
#
# You may supply these EITHER here OR via .env (AUTH_OIDC_ISSUER /
# AUTH_OIDC_ADMIN_DOMAIN), which the deploy scripts map to TF_VAR_*.
# ⚠️  Do NOT set them to an empty string ("") here — to Terraform that is a real
# value that OVERRIDES the .env/TF_VAR_ value (TF_VAR_* is lowest precedence).
# To let .env supply them, leave these keys commented out / absent entirely.

# oidc_issuer       = "https://accounts.google.com"
# oidc_admin_domain = "example.com"

# ── Optional: interactive OIDC (SSO) login ────────────────────────────────────
# Enables the "Sign in with SSO" button. Requires oidc_issuer (above) PLUS these
# two from a "Web application" OAuth client whose authorized redirect URI is
# {auth_url}/api/auth/callback/oidc — i.e. anchored on the public browser-facing
# URL, custom domain included (printed as the oidc_callback_url output).
# NOT needed for the agent device-grant flow.

oidc_client_id     = ""   # SENSITIVE — do not commit
oidc_client_secret = ""   # SENSITIVE — do not commit

# ── Agent device-grant secrets live in .env, NOT here ─────────────────────────
# The agent client id/secret are sourced from the repo-root .env by the deploy
# scripts (deploy.sh / apply.sh, via common.sh -> load_env_tfvars) and passed to
# Terraform as TF_VAR_*. Do NOT add agent_oidc_client_id / agent_oidc_client_secret
# / agent_key_secret here: TF_VAR_* is the lowest-precedence source, so an entry
# in this file (even an empty "") would OVERRIDE the value from .env and silently
# break the feature. Set these in .env instead:
#
#   AGENT_OIDC_CLIENT_ID=...        # from the "TVs and Limited Input devices" client
#   AGENT_OIDC_CLIENT_SECRET=...
#   AGENT_KEY_TTL_SECONDS=900       # optional; minted-key lifetime, default 900
#   AGENT_KEY_SECRET=...            # optional; falls back to AUTH_SECRET when unset
#
# See AGENTS.md for the full setup, including registering the second OAuth client.

# ── AUTH_URL / cleanup audience (see variables.tf for full docs) ─────────────
# Leave BOTH commented out for the very first apply against a brand-new
# service — Cloud Run v2 URLs contain a hash that can't be known before the
# service exists. After the first apply, run `terraform output -raw
# service_url`, then set:
#
#   - cleanup_audience: the run.app URL, exactly as printed. The OIDC audience
#     the cleanup route verifies Cloud Scheduler tokens against. A lifecycle
#     postcondition fails future applies loudly if the live uri ever diverges
#     from it (service recreated -> new URL hash).
#   - auth_url: the PUBLIC browser-facing URL — the custom domain if one is
#     mapped, otherwise the same run.app URL. Required for SSO: Auth.js anchors
#     the entire OAuth flow to it (without it, the authorization request and
#     token exchange disagree about the app's origin and Google rejects the
#     exchange with redirect_uri_mismatch). NOT asserted against the service
#     uri — a custom domain never matches it.
#
# ...then re-apply.

# auth_url         = "https://fileshare.example.com"
# cleanup_audience = "https://fileshare-abc123-uc.a.run.app"

# ── Secret Manager IAM migration (two-apply; see the runbook in iam.tf) ──────
# Leave false until the per-secret secretmanager.secretAccessor bindings have
# been applied AND a rolled revision has been confirmed to start with them.
# On a BRAND-NEW environment (nothing running yet), set true from the very
# first apply — the two-apply sequence only protects an already-live service.

# revoke_project_secret_accessor = false

# ── Dev CORS origin (defaults to false) ───────────────────────────────────────
# Set to true only while testing signed-URL uploads against production GCS
# from a local `next dev` server. The production file bucket should not
# permanently trust http://localhost:3000.

# allow_dev_cors_origin = false

# ── Custom domain (optional) ──────────────────────────────────────────────────
# When set, this hostname is added to the GCS bucket CORS policy so that
# browser XHR uploads from the custom domain are allowed. Note: the DNS zone
# and Cloud Run domain mapping themselves live in dns.tf with LITERAL names —
# a new environment must edit (or delete) that file, not just this variable.

# custom_domain = "fileshare.example.com"

# ── Optional overrides ────────────────────────────────────────────────────────

# owner/repo allowed to deploy via Workload Identity Federation (deploy.yml).
# Change this when deploying from a fork or a new repository.
# github_repository = "mbarretta/brushpass"

# cloud_run_service_name = "fileshare"
# cloud_run_memory       = "512Mi"
# cloud_run_cpu          = "1"
# artifact_registry_repo = "cloud-run-source-deploy"

# cloud_run_max_instance_count MUST stay 1 (SQLite over GCS FUSE is not
# multi-writer safe; the rate limiter is per-instance) — do not override this.
